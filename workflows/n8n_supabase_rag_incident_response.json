{
  "name": "AI Incident Response - Supabase RAG & Telegram Orchestrator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "incident-alert",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-500, -200],
      "id": "node-webhook-trigger",
      "name": "Incoming Alert Webhook",
      "webhookId": "incident-alert-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Extract and normalize incoming alert payload\nconst input = $json.body || $json;\n\nlet alert = {\n  source: input.source || (input.alerts ? 'prometheus' : (input.ruleName ? 'grafana' : 'custom')),\n  alert_name: input.alert_name || input.ruleName || (input.alerts && input.alerts[0]?.labels?.alertname) || 'SystemAlert',\n  description: input.description || input.message || (input.alerts && input.alerts[0]?.annotations?.description) || JSON.stringify(input),\n  severity: input.severity || (input.alerts && input.alerts[0]?.labels?.severity) || 'High',\n  service: input.service || (input.alerts && input.alerts[0]?.labels?.job) || 'backend-service',\n  instance: input.instance || (input.alerts && input.alerts[0]?.labels?.instance) || 'node-prod-01',\n  raw_payload: input\n};\n\nalert.fingerprint = `${alert.source}::${alert.alert_name}::${alert.service}::${alert.instance}`.toLowerCase();\n\nreturn [{ json: alert }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-300, -200],
      "id": "node-payload-normalizer",
      "name": "Normalize & Deduplicate Alert"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an SRE Incident Commander. An alert has fired for service: {{$json.service}}.\nAlert Name: {{$json.alert_name}}\nDescription: {{$json.description}}\nSeverity: {{$json.severity}}\nInstance: {{$json.instance}}\n\nSearch the Supabase vector store for the matching SOP runbook and determine root-cause hypothesis, risk level, and mitigation command.",
        "options": {
          "maxIterations": 15,
          "systemMessage": "You are an autonomous Site Reliability AI Agent. Search SOP runbooks using semantic vector search and provide actionable triage recommendations."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [-60, -200],
      "id": "node-rag-ai-agent",
      "name": "Supabase RAG Incident Agent"
    },
    {
      "parameters": {
        "modelName": "models/gemini-1.5-flash",
        "options": {
          "temperature": 0.2
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [-200, 60],
      "id": "node-gemini-model",
      "name": "Google Gemini 2.5 Flash",
      "credentials": {
        "googleGeminiApi": {
          "id": "gemini-api-credentials",
          "name": "Gemini API Key"
        }
      }
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolName": "search_sop_runbooks",
        "toolDescription": "Searches standard operating procedure (SOP) runbooks in Supabase pgvector store using cosine similarity",
        "tableName": "runbooks",
        "options": {
          "matchThreshold": 0.6
        }
      },
      "type": "@n8n/n8n-nodes-langchain.vectorStorePGVector",
      "typeVersion": 1,
      "position": [40, 60],
      "id": "node-supabase-vector-store",
      "name": "Supabase Vector Store (runbooks)",
      "credentials": {
        "postgres": {
          "id": "supabase-postgres-credentials",
          "name": "Supabase PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "modelName": "models/text-embedding-004"
      },
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [40, 220],
      "id": "node-gemini-embeddings",
      "name": "Embeddings Google Gemini",
      "credentials": {
        "googleGeminiApi": {
          "id": "gemini-api-credentials",
          "name": "Gemini API Key"
        }
      }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $json.fingerprint }}",
        "tableName": "n8n_chat_histories"
      },
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
      "typeVersion": 1.3,
      "position": [240, 60],
      "id": "node-postgres-chat-memory",
      "name": "Postgres Incident Memory",
      "credentials": {
        "postgres": {
          "id": "supabase-postgres-credentials",
          "name": "Supabase PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/webhook/alerts",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, -200],
      "id": "node-fastapi-backend-dispatch",
      "name": "FastAPI Triage & Safety Dispatcher"
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🚨 <b>NEW INCIDENT DETECTED VIA N8N WORKFLOW</b>\n\n<b>Incident:</b> {{$json.title}}\n<b>Severity:</b> {{$json.severity}}\n<b>Root Cause:</b> {{$json.root_cause_hypothesis}}\n<b>Safe Action:</b> <code>{{$json.recommended_safe_command}}</code>",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [440, -200],
      "id": "node-telegram-notifier",
      "name": "Telegram Incident Notifier",
      "credentials": {
        "telegramApi": {
          "id": "telegram-bot-credentials",
          "name": "Telegram Bot Token"
        }
      }
    }
  ],
  "connections": {
    "Incoming Alert Webhook": {
      "main": [
        [
          {
            "node": "Normalize & Deduplicate Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize & Deduplicate Alert": {
      "main": [
        [
          {
            "node": "Supabase RAG Incident Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Gemini 2.5 Flash": {
      "ai_languageModel": [
        [
          {
            "node": "Supabase RAG Incident Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Embeddings Google Gemini": {
      "ai_embedding": [
        [
          {
            "node": "Supabase Vector Store (runbooks)",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    },
    "Supabase Vector Store (runbooks)": {
      "ai_tool": [
        [
          {
            "node": "Supabase RAG Incident Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "Postgres Incident Memory": {
      "ai_memory": [
        [
          {
            "node": "Supabase RAG Incident Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "Supabase RAG Incident Agent": {
      "main": [
        [
          {
            "node": "FastAPI Triage & Safety Dispatcher",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "FastAPI Triage & Safety Dispatcher": {
      "main": [
        [
          {
            "node": "Telegram Incident Notifier",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
