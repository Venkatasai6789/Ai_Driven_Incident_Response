# ==============================================================================
# AI-Driven Incident Response & IT Alert Management System
# Master Environment Variables Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# Phase 1: Database Configuration (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=incident_user
POSTGRES_PASSWORD=incident_secure_pass_2024
POSTGRES_DB=incident_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://incident_user:incident_secure_pass_2024@localhost:5432/incident_db

# Optional Superuser credentials for initial database setup (db/setup_db.py)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres

# ------------------------------------------------------------------------------
# Phase 2: Vector Embeddings & RAG (Google Gemini API)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
SIMILARITY_THRESHOLD=0.3

# ------------------------------------------------------------------------------
# Phase 3: Workflow Automation & Webhooks (n8n + Gemini Flash)
# ------------------------------------------------------------------------------
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/alert-ingestion
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Phase 4: Remediation, Safety Engine & Telegram Approvals
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# SSH Remediation Target (Optional / Staging)
SSH_HOST=127.0.0.1
SSH_PORT=22
SSH_USER=ops_runner
SSH_KEY_PATH=~/.ssh/id_rsa

# ------------------------------------------------------------------------------
# Phase 5: Verification, Escalation & Post-Mortem Notifications
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password_here
ONCALL_EMAIL=oncall-team@yourcompany.com
ALERT_SOURCE_URL=http://localhost:8080/health
